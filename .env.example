# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=briquotheque
DB_PASSWORD=
DB_DATABASE=briquotheque

# Rate limiting (database recommended in production)
LIMITER_STORE=database

# Brickset API v3 — free key: https://brickset.com/tools/webservices/requestkey/
BRICKSET_API_KEY=

# BrickLink API (optional, OAuth 1.0 — tokens are bound to an IP address)
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=