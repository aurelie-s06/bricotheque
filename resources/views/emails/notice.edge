<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ subject }}</title>
  </head>
  <body
    style="margin:0;padding:24px;background:#FAFAF7;font-family:Arial,Helvetica,sans-serif;color:#1F2328;line-height:1.5;"
  >
    <table
      role="presentation"
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="max-width:560px;margin:0 auto;background:#FFFFFF;border:1px solid #E4E2DC;border-radius:6px;"
    >
      <tr>
        <td style="padding:32px;">
          <p style="margin:0 0 24px;font-size:22px;font-weight:bold;">Bricothèque</p>
          <p style="margin:0 0 16px;">{{ greeting }}</p>
          @each(paragraph in paragraphs)
            <p style="margin:0 0 16px;">{{ paragraph }}</p>
          @end
          @if(button)
            <p style="margin:8px 0 24px;">
              <a
                href="{{ button.url }}"
                style="display:inline-block;padding:12px 20px;background:#F2B11F;color:#1F2328;font-weight:bold;text-decoration:none;border-radius:6px;border-bottom:4px solid #D9961A;"
              >
                {{ button.label }}
              </a>
            </p>
          @end
          @each(note in notes)
            <p style="margin:0 0 8px;font-size:14px;color:#5B6470;">{{ note }}</p>
          @end
          @if(button)
            <p style="margin:16px 0 0;font-size:12px;color:#5B6470;word-break:break-all;">
              {{ button.url }}
            </p>
          @end

          <hr style="border:0;border-top:1px solid #E4E2DC;margin:24px 0 16px;" />
          <p style="margin:0;font-size:12px;color:#5B6470;">{{ footer }}</p>
        </td>
      </tr>
    </table>
  </body>
</html>
